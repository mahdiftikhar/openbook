# DeepSeek API Key (required)
# Get yours at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek model (optional)
# deepseek-chat = DeepSeek-V3 (fast, general purpose)
# deepseek-reasoner = DeepSeek-R1 (reasoning, slower but deeper)
DEEPSEEK_MODEL=deepseek-chat

# Database path (optional, defaults to ./data/openbook.db)
DATABASE_PATH=./data/openbook.db
